{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "api": {
      "additionalProperties": false,
      "properties": {
        "routes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "method": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "path": {
                "pattern": "^/api/",
                "type": "string"
              }
            },
            "required": [
              "name",
              "method",
              "path"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "routes"
      ],
      "type": "object"
    },
    "app_slug": {
      "pattern": "^[a-z0-9-]{3,60}$",
      "type": "string"
    },
    "providers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "config_schema_ref": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "config_schema_ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "build_plan.v1",
      "type": "string"
    },
    "schemas": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "json_schema": {
            "type": "object"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "json_schema"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "ui": {
      "additionalProperties": false,
      "properties": {
        "pages": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "slug": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "title"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "pages"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "app_slug",
    "ui",
    "api",
    "providers",
    "schemas"
  ],
  "title": "build_plan.v1",
  "type": "object"
}