{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Registry",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "subsystem", "enabled"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "subsystem": {"type": "string"},
          "enabled": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
