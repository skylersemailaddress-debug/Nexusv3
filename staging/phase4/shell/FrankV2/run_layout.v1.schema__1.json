{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_layout.v1.schema.json",
  "title": "RunLayoutV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "run_dir", "artifacts_dir", "evidence_dir", "build_report_path", "ok"],
  "properties": {
    "kind": { "const": "run_layout.v1" },
    "run_dir": { "type": "string", "minLength": 1 },
    "artifacts_dir": { "type": "string", "minLength": 1 },
    "evidence_dir": { "type": "string", "minLength": 1 },
    "build_report_path": { "type": "string", "minLength": 1 },

    "has_failure_packet": { "type": "boolean" },
    "failure_packet_dir": { "type": ["string","null"] },

    "evidence_manifest_path": { "type": ["string","null"] },

    "ok": { "type": "boolean" },
    "fail_reasons": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
