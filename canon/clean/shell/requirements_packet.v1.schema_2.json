{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "app_slug": {
      "pattern": "^[a-z0-9-]{3,60}$",
      "type": "string"
    },
    "functional_requirements": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^FR-[0-9]{4}$",
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "nonfunctional_requirements": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "pattern": "^NFR-[0-9]{4}$",
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "open_questions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "blocking": {
            "type": "boolean"
          },
          "id": {
            "pattern": "^Q-[0-9]{4}$",
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "blocking"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "requirements_packet.v1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "app_slug",
    "functional_requirements",
    "nonfunctional_requirements",
    "open_questions"
  ],
  "title": "requirements_packet.v1",
  "type": "object"
}